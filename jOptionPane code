import javax.swing.JOptionPane;

public class Electric_bill_calculation {
    public static void main(String[] args) {

        // character array
        char charArray[] = {'b', 'i', 'r', 't', 'h', ' ', 'd', 'a', 'y'};

        // byte array
        byte byteArray[] = {
                (byte) 'n', (byte) 'e', (byte) 'w', (byte) ' ',
                (byte) 'y', (byte) 'e', (byte) 'a', (byte) 'r'
        };

        // String and StringBuffer
        String s = new String("hello");
        StringBuffer buffer = new StringBuffer("Welcome");

        // Creating different string objects
        String s1 = new String();               // empty string
        String s2 = new String(s);              // hello
        String s3 = new String(charArray);      // birth day
        String s4 = new String(charArray, 6, 3);// day
        String s5 = new String(byteArray, 4, 4);// year
        String s6 = new String(byteArray);      // new year
        String s7 = new String(buffer);         // Welcome

        // Output formatting
        String output =
                "s1 = " + s1 +
                        "\ns2 = " + s2 +
                        "\ns3 = " + s3 +
                        "\ns4 = " + s4 +
                        "\ns5 = " + s5 +
                        "\ns6 = " + s6 +
                        "\ns7 = " + s7;

        // Display dialog box
        JOptionPane.showMessageDialog(null, output);
        System.exit(0);
    }
}
