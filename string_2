public class StringBufferFullExample {
    public static void main(String[] args) {
        
        // =========================
        // 1️⃣ Constructors
        // =========================
        
        // Default constructor
        StringBuffer sb1 = new StringBuffer();
        System.out.println("sb1: '" + sb1 + "', Capacity: " + sb1.capacity());

        // Constructor with initial capacity
        StringBuffer sb2 = new StringBuffer(50);
        System.out.println("sb2: '" + sb2 + "', Capacity: " + sb2.capacity());

        // Constructor with initial string
        StringBuffer sb3 = new StringBuffer("Hello");
        System.out.println("sb3: '" + sb3 + "', Capacity: " + sb3.capacity()); // 16 + 5 = 21

        System.out.println("\n--- StringBuffer Methods ---");

        // =========================
        // 2️⃣ append()
        // =========================
        sb3.append(" World");        // append String
        sb3.append(2025);            // append int
        System.out.println("After append: " + sb3);

        // =========================
        // 3️⃣ insert()
        // =========================
        sb3.insert(6, "Java ");      // insert at index 6
        System.out.println("After insert: " + sb3);

        // =========================
        // 4️⃣ delete()
        // =========================
        sb3.delete(11, 15);          // delete characters from index 11 to 14
        System.out.println("After delete: " + sb3);

        // =========================
        // 5️⃣ replace()
        // =========================
        sb3.replace(6, 10, "C++");   // replace from index 6 to 9
        System.out.println("After replace: " + sb3);

        // =========================
        // 6️⃣ reverse()
        // =========================
        sb3.reverse();
        System.out.println("After reverse: " + sb3);

        // =========================
        // 7️⃣ length() and capacity()
        // =========================
        System.out.println("Length: " + sb3.length());
        System.out.println("Capacity: " + sb3.capacity());


//Mnemonic for StringBuffer Capacity:

//Default: 16 + initial string length

///Length < capacity → capacity একই থাকে

//Length > capacity → newCapacity = old*2 + 2
    }
}

